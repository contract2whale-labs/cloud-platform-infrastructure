# backend.hcl.example — dev bootstrap/state 루트 모듈
# backend.hcl 로 복사한 뒤 bucket 과 allowed_account_ids 를 state 출력값으로 바꿉니다. backend.hcl 은 커밋하지 않습니다.
# 사용: terraform init -backend-config=backend.hcl   (lab.sh 의 up · down 도 같은 방식으로 초기화)

bucket              = "company-dev-tfstate-111111111111"  # 예: terraform output -raw state_bucket_name 의 값
key                 = "bootstrap/state/terraform.tfstate" # 예: 실행 디렉터리 경로와 같은 구조 (환경 이름은 버킷이 이미 구분)
region              = "ap-northeast-2"                    # 예: terraform output -raw state_region 의 값
encrypt             = true                                # 예: true (State 객체 저장 암호화 요청)
use_lockfile        = true                                # 예: true (State key 뒤 .tflock 객체로 동시 실행 차단; DynamoDB 불필요)
allowed_account_ids = ["111111111111"]                    # 예: terraform output -raw expected_account_id 의 값
