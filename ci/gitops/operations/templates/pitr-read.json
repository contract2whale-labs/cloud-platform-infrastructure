{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "__READ_JOB_NAME__",
    "namespace": "contract2whale-demo",
    "labels": {
      "app.kubernetes.io/name": "database-operator-check",
      "app.kubernetes.io/part-of": "contract2whale",
      "recovery.course/experiment-id": "__RUN_ID__"
    }
  },
  "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 180,
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/name": "database-operator-check",
          "app.kubernetes.io/part-of": "contract2whale",
          "recovery.course/experiment-id": "__RUN_ID__"
        }
      },
      "spec": {
        "serviceAccountName": "database-operator",
        "automountServiceAccountToken": false,
        "restartPolicy": "Never",
        "nodeSelector": {
          "workload": "app"
        },
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 1000,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containers": [
          {
            "name": "read",
            "image": "__OPERATOR_IMAGE__",
            "command": [
              "bash",
              "-c"
            ],
            "args": [
              "set -euo pipefail\ncreds=\"$(aws secretsmanager get-secret-value --secret-id \"$APP_SECRET_ARN\" --query SecretString --output text)\"\nPGUSER=\"$(echo -n \"$creds\" | jq -r .username)\"\nPGPASSWORD=\"$(echo -n \"$creds\" | jq -r .password)\"\nexport PGUSER PGPASSWORD\npsql -Atc \"SELECT 'tables=' || count(*) FROM information_schema.tables WHERE table_schema = 'public'\"\npsql -Atc \"SELECT 'products=' || count(*) FROM public.product\"\npsql -Atc \"SELECT 'orders=' || count(*) FROM public.\\\"order\\\"\"\npsql -Atc \"SELECT 'digest=' || md5(string_agg(handle || ':' || status, ',' ORDER BY handle)) FROM public.product\"\npsql -Atc \"SELECT 'sample=' || status FROM public.product WHERE handle = '__SAMPLE_HANDLE__'\"\npsql -Atc \"SELECT 'row=' || id || '|' || handle || '|' || status FROM public.product ORDER BY id\"\n"
            ],
            "env": [
              {
                "name": "PGHOST",
                "value": "__DB_HOST__"
              },
              {
                "name": "PGPORT",
                "value": "5432"
              },
              {
                "name": "PGDATABASE",
                "value": "commercedb"
              },
              {
                "name": "PGSSLMODE",
                "value": "verify-full"
              },
              {
                "name": "PGSSLROOTCERT",
                "value": "/opt/contract2whale/certs/rds-global-bundle.pem"
              },
              {
                "name": "PGCONNECT_TIMEOUT",
                "value": "10"
              },
              {
                "name": "PGOPTIONS",
                "value": "-c default_transaction_read_only=on"
              },
              {
                "name": "APP_SECRET_ARN",
                "value": "__APP_SECRET_ARN__"
              }
            ],
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "128Mi"
              },
              "limits": {
                "memory": "256Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
