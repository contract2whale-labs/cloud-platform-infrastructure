{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "incident-db-connect-during-20261008t090000",
    "namespace": "contract2whale-demo",
    "labels": {
      "incident.course/attempt": "dbe-20261008t090000"
    }
  },
  "spec": {
    "ttlSecondsAfterFinished": 600,
    "backoffLimit": 0,
    "activeDeadlineSeconds": 120,
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/name": "database-operator-check",
          "incident.course/attempt": "dbe-20261008t090000"
        }
      },
      "spec": {
        "serviceAccountName": "database-operator",
        "automountServiceAccountToken": false,
        "restartPolicy": "Never",
        "nodeSelector": {
          "workload": "app"
        },
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 1000,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containers": [
          {
            "name": "check",
            "image": "<승인된 운영자 이미지의 실제 @sha256 참조>",
            "envFrom": [
              {
                "configMapRef": {
                  "name": "database-bootstrap-reviewedrequest001"
                }
              }
            ],
            "env": [
              {
                "name": "EXPECTED_OPERATOR_ROLE_ARN",
                "value": "<승인된 Dev database-operator role ARN>"
              }
            ],
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "128Mi"
              },
              "limits": {
                "memory": "256Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
